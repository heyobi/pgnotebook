{
  "name": "pgnotebook",
  "private": true,
  "version": "1.0.0",
  "description": "PostgreSQL notebooks that run entirely on your iPhone (PGlite + PostGIS + pgvector).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "cap:sync": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-age": "^0.0.17",
    "@electric-sql/pglite-pg_hashids": "^0.0.17",
    "@electric-sql/pglite-pg_ivm": "^0.0.17",
    "@electric-sql/pglite-pg_textsearch": "^0.0.18",
    "@electric-sql/pglite-pg_uuidv7": "^0.0.17",
    "@electric-sql/pglite-pgmq": "^0.0.14",
    "@electric-sql/pglite-pgtap": "^0.0.17",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "@electric-sql/pglite-postgis": "^0.2.16",
    "codemirror": "^6.0.2",
    "marked": "^18.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
